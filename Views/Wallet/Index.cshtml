
@model EWallet.ViewModels.WalletViewModel

@{
    ViewData["Title"] = "My Wallet";
    ViewData["FullWidth"] = true;
}

<style>
    .wallet-dashboard {
        background: #F8FAFD;
        min-height: calc(100vh - 160px);
        padding: 48px 24px;
    }

    .wallet-dashboard .dashboard-container {
        max-width: 1280px;
        margin: 0 auto;
    }

    .wallet-dashboard .dashboard-label {
        color: #2563A6;
        font-size: 12px;
        font-weight: 700;
        letter-spacing: 2px;
    }

    .wallet-dashboard .dashboard-title {
        color: #142D50;
        font-weight: 700;
    }

    .wallet-dashboard .wallet-card {
        background: linear-gradient(135deg, #142D50, #2563A6);
        border-radius: 20px;
        box-shadow: 0 16px 35px rgba(20, 45, 80, 0.15);
    }

    .wallet-dashboard .info-card {
        background: #FFFFFF;
        border: 1px solid #EDF1F6;
        border-radius: 20px;
        box-shadow: 0 5px 20px rgba(20, 45, 80, 0.05);
    }

    .wallet-dashboard .section-title {
        color: #142D50;
        font-weight: 700;
    }

    .wallet-dashboard .profile-value {
        font-weight: 600;
        color: #142D50;
        overflow-wrap: anywhere;
    }

    .wallet-dashboard .edit-profile-btn {
        color: #2563A6;
        border: 1px solid #2563A6;
        border-radius: 30px;
        padding: 7px 18px;
        text-decoration: none;
        transition: all 0.2s ease;
    }

    .wallet-dashboard .edit-profile-btn:hover {
        color: #FFFFFF;
        background: #2563A6;
    }

    @@media (max-width: 767.98px) {
        .wallet-dashboard {
            padding: 28px 16px;
        }
    }
</style>

<div class="wallet-dashboard">

    <div class="dashboard-container">

        <!-- HEADER -->
        <div class="mb-4">
            <p class="dashboard-label text-uppercase mb-2">
                CLIENT DASHBOARD
            </p>

            <h2 class="dashboard-title mb-2">
                Welcome, @Model.Prenom @Model.Nom
            </h2>

            <p class="text-muted mb-0">
                View your balance and manage your account information.
            </p>
        </div>

        @if (!Model.HasAccount)
        {
            <!-- NO WALLET -->
            <div class="alert alert-warning rounded-4">
                <h5 class="fw-bold">Wallet not available</h5>
                <p class="mb-0">
                    Your wallet has not been created yet.
                    Please contact the administrator.
                </p>
            </div>
        }
        else
        {
            <div class="row g-4">

                <!-- BALANCE CARD -->
                <div class="col-lg-7">
                    <div class="card border-0 wallet-card text-white h-100">
                        <div class="card-body p-4">

                            <p class="mb-2 opacity-75">
                                Available Balance
                            </p>

                            <h1 class="display-5 fw-bold mb-3"
                                style="color: #FFFFFF;">
                                @Model.Solde.ToString("N2")
                                <span class="fs-4"
                                      style="color: #FFFFFF;">
                                    @Model.Devise
                                </span>
                            </h1>

                            <hr class="border-light opacity-25" />

                            <div class="d-flex justify-content-between align-items-end gap-3">

                                <div>
                                    <small class="opacity-75">
                                        Account Number
                                    </small>
                                    <div class="fw-semibold text-break">
                                        @Model.NumeroCompte
                                    </div>
                                </div>

                                <div class="d-flex flex-column align-items-center gap-2">
                                    <small class="opacity-75">
                                        Status
                                    </small>

                                    <span class="badge rounded-pill px-3 py-2
                                        @(Model.Statut == "Active" ? "bg-success" :
                                          Model.Statut == "Blocked" ? "bg-danger" :
                                          "bg-secondary")">
                                        @Model.Statut
                                    </span>
                                </div>

                            </div>
                        </div>
                    </div>
                </div>

                <!-- ACCOUNT INFORMATION -->
                <div class="col-lg-5">
                    <div class="card info-card h-100">
                        <div class="card-body p-4">

                            <h5 class="section-title mb-4">
                                Account Information
                            </h5>

                            <div class="mb-3">
                                <small class="text-muted">
                                    Account Type
                                </small>
                                <div class="fw-semibold">
                                    Wallet
                                </div>
                            </div>

                            <div class="mb-3">
                                <small class="text-muted">
                                    Currency
                                </small>
                                <div class="fw-semibold">
                                    @Model.Devise
                                </div>
                            </div>

                            <div>
                                <small class="text-muted">
                                    Creation Date
                                </small>
                                <div class="fw-semibold">
                                    @Model.DateCreation.ToString("dd/MM/yyyy")
                                </div>
                            </div>

                        </div>
                    </div>
                </div>

            </div>
        }

        <!-- PERSONAL PROFILE -->
        <div class="card info-card mt-4">
            <div class="card-body p-4">

                <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">

                    <h5 class="section-title mb-0">
                        Personal Profile
                    </h5>

                    <a asp-area="Identity"
                       asp-page="/Account/Manage/Index"
                       class="edit-profile-btn">
                        Edit Profile
                    </a>

                </div>

                <div class="row g-4">

                    <!-- FULL NAME -->
                    <div class="col-md-4">
                        <small class="text-muted">
                            Full Name
                        </small>
                        <div class="profile-value">
                            @Model.Prenom @Model.Nom
                        </div>
                    </div>

                    <!-- EMAIL -->
                    <div class="col-md-4">
                        <small class="text-muted">
                            Email
                        </small>
                        <div class="profile-value">
                            @Model.Email
                        </div>
                    </div>

                    <!-- USERNAME -->
                    <div class="col-md-4">
                        <small class="text-muted">
                            Username
                        </small>
                        <div class="profile-value">
                            @Model.UserName
                        </div>
                    </div>

                    <!-- PHONE NUMBER -->
                    <div class="col-md-4">
                        <small class="text-muted">
                            Phone Number
                        </small>
                        <div class="profile-value">
                            @(string.IsNullOrWhiteSpace(Model.PhoneNumber)
                                ? "Not provided"
                                : Model.PhoneNumber)
                        </div>
                    </div>

                    <!-- REGISTRATION DATE -->
                    <div class="col-md-4">
                        <small class="text-muted">
                            Registration Date
                        </small>
                        <div class="profile-value">
                            @(Model.UserDateCreation == default
                                ? "Not available"
                                : Model.UserDateCreation.ToString("dd/MM/yyyy"))
                        </div>
                    </div>

                </div>
            </div>
        </div>

    </div>
</div>


@model List<EWallet.Models.Account>

@{
    ViewData["Title"] = "Accounts Management";
    Layout = "_AdminLayout";
}

@if (TempData["Success"] != null)
{
    <div class="bg-green-100 border border-green-400 text-green-800
                px-4 py-3 rounded-lg mb-4">
        @TempData["Success"]
    </div>
}

<div class="p-6">
    <h1 class="text-2xl font-bold text-gray-800">
        Accounts Management
    </h1>

    <p class="text-gray-500 mt-2">
        Manage and view all EWallet accounts.
    </p>
</div>

<div class="p-6">
    <div class="overflow-x-auto rounded-lg border border-gray-200">
        <table class="w-full text-left text-sm">
            <thead class="bg-gray-100 text-gray-700">
                <tr>
                    <th class="p-3">Account Number</th>
                    <th class="p-3">Balance</th>
                    <th class="p-3">Currency</th>
                    <th class="p-3">Status</th>
                    <th class="p-3">Creation Date</th>
                    <th class="p-3">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var account in Model)
                {
                    <tr class="border-t border-gray-200">
                        <td class="p-3">@account.NumeroCompte</td>
                        <td class="p-3">@account.Solde</td>
                        <td class="p-3">@account.Devise</td>
                        <td class="p-3">@account.Statut</td>
                        <td class="p-3">@account.DateCreation.ToString("dd/MM/yyyy")</td>
                        <td class="p-3">
                          <a asp-controller="Admin"
                             asp-action="Details"
                             asp-route-id="@account.IdAccount"
                            class="text-blue-600 hover:underline font-medium">
                             Details
                          </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@{
    int currentPage = ViewBag.CurrentPage;
    int totalPages = ViewBag.TotalPages;
}

@if (totalPages > 1)
{
    <div class="flex justify-center items-center gap-3 mt-6">

        @if (currentPage > 1)
        {
            <a asp-controller="Admin"
               asp-action="Accounts"
               asp-route-page="@(currentPage - 1)"
               class="px-4 py-2 bg-gray-200 rounded-lg hover:bg-gray-300">
                Previous
            </a>
        }

        <span class="text-gray-700 font-medium">
            Page @currentPage of @totalPages
        </span>

        @if (currentPage < totalPages)
        {
            <a asp-controller="Admin"
               asp-action="Accounts"
               asp-route-page="@(currentPage + 1)"
               class="px-4 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700">
                Next
            </a>
        }

    </div>
}

@using EWallet.Models
@using Microsoft.AspNetCore.Identity
@inject UserManager<ApplicationUser> UserManager

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - EWallet Admin</title>

    <script src="https://cdn.jsdelivr.net/npm/@@tailwindcss/browser@4"></script>
</head>

<body class="min-h-screen" style="background: #F8FAFD;">

    <!-- ADMIN NAVBAR -->
    <header class="bg-white border-b border-gray-200 shadow-sm">

        <nav class="w-full px-6 py-5 flex flex-wrap items-center justify-between gap-4">

            <!-- LEFT NAVIGATION -->
            <div class="flex flex-wrap items-center gap-3">

                <!-- BRAND -->
                <a asp-controller="Home"
                   asp-action="Index"
                   class="font-bold mr-3"
                   style="color: #142D50;
                          font-size: 24px;
                          letter-spacing: -0.5px;">
                    EWallet
                </a>

                <!-- HOME -->
                <a asp-controller="Home"
                   asp-action="Index"
                   class="px-4 py-2 rounded-xl font-medium transition-colors"
                   style="color: #142D50;">
                    Home
                </a>

                <!-- ACCOUNTS -->
                <a asp-controller="Admin"
                   asp-action="Accounts"
                   class="px-4 py-2 rounded-xl font-medium transition-colors"
                   style="color: #142D50;">
                    Accounts
                </a>

            </div>

            <!-- RIGHT NAVIGATION -->
            <div class="flex flex-wrap items-center gap-3">

                <!-- ADMIN NAME -->
                <span class="px-3 py-2 font-medium"
                      style="color: #142D50;">
                    @{
                       var adminUser = await UserManager.GetUserAsync(User);
                     }

                    @if (adminUser != null)
                     {
                       <text>Hello, @adminUser.Prenom @adminUser.Nom</text>
                     }
                       else
                     {
                     <text>Hello, @User.Identity?.Name</text>
                     }
                </span>

                <!-- LOGOUT -->
                <form asp-area="Identity"
                      asp-page="/Account/Logout"
                      asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })"
                      method="post">

                    <button type="submit"
                            class="px-4 py-2 rounded-xl font-medium transition-colors"
                            style="color: #142D50;">
                        Logout
                    </button>

                </form>

            </div>

        </nav>

    </header>

    <!-- ADMIN CONTENT -->
    <main class="max-w-7xl mx-auto p-6">
        @RenderBody()
    </main>

</body>
</html>

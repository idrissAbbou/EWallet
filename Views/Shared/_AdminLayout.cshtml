
@using EWallet.Models
@using Microsoft.AspNetCore.Identity
@inject UserManager<ApplicationUser> UserManager

@{
    var adminUser = await UserManager.GetUserAsync(User);
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - EWallet Admin</title>

    <script src="https://cdn.jsdelivr.net/npm/@@tailwindcss/browser@4"></script>
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
</head>

<body class="min-h-screen admin-body">

    <!-- ADMIN NAVBAR -->
    <header class="bg-white border-b border-gray-200 shadow-sm">

        <nav class="w-full px-6 py-5 flex flex-wrap items-center justify-between gap-4">

            <!-- LEFT NAVIGATION -->
            <div class="flex flex-wrap items-center gap-3">

                <!-- BRAND -->
                <a asp-controller="Home"
                   asp-action="Index"
                   class="font-bold mr-3 admin-brand">
                    EWallet
                </a>

                <!-- HOME -->
                <a asp-controller="Home"
                   asp-action="Index"
                   class="px-4 py-2 rounded-xl font-medium transition-colors admin-nav-link">
                    Home
                </a>

                <!-- ACCOUNTS -->
                <a asp-controller="Admin"
                   asp-action="Accounts"
                   class="px-4 py-2 rounded-xl font-medium transition-colors admin-nav-link">
                    Accounts
                </a>

            </div>

            <!-- RIGHT NAVIGATION -->
            <div class="flex flex-wrap items-center gap-3">

                <!-- ADMIN NAME -->
                <span class="px-3 py-2 font-medium admin-user-name">
                    @if (adminUser != null)
                    {
                        <text>Hello, @adminUser.Prenom @adminUser.Nom</text>
                    }
                    else
                    {
                        <text>Hello, @User.Identity?.Name</text>
                    }
                </span>

                <!-- LOGOUT -->
                <form asp-area="Identity"
                      asp-page="/Account/Logout"
                      asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })"
                      method="post">

                    <button type="submit"
                            class="px-4 py-2 rounded-xl font-medium transition-colors admin-logout">
                        Logout
                    </button>

                </form>

            </div>

        </nav>

    </header>

    <!-- ADMIN CONTENT -->
    <main class="max-w-7xl mx-auto p-6">
        @RenderBody()
    </main>

</body>
</html>
